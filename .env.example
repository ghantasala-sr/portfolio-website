# Copy to .env.local and fill in. None of these are read on the client:
# no NEXT_PUBLIC_ prefix means no value here ever reaches the browser bundle.
#
# The site runs fine with all four unset. /admin then shows a "not configured"
# notice, and view counts fall back to an in-memory counter that resets on every
# server restart.

# ── Admin page (/admin) ──────────────────────────────────────────────────────

# The password you type into /admin. Pick something long; it is the only thing
# standing between the internet and the dashboard.
ADMIN_PASSWORD=

# Signs the session cookie so it cannot be forged. Any long random string.
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ── View counters (Upstash Redis, free tier is far more than enough) ──────────
# console.upstash.com -> create a Redis database -> REST API -> copy both.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────────

# Extra salt for the daily visitor hash. Falls back to ADMIN_SESSION_SECRET when
# unset, which is fine; set it separately only if you want the two rotated
# independently.
VISITOR_SALT=
